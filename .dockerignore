# Dependency and build artifacts
node_modules
**/node_modules
**/.next
**/dist
**/*.tsbuildinfo
.turbo
coverage

# Runtime state written by the API into the bind-mounted source tree (Traefik
# config, logs, SSH keys). The dev container creates `apps/astron/.docker/ssh`
# as root with 0700, which otherwise makes `docker build` fail with
# "open .../ssh: permission denied" while loading the build context.
apps/astron/.docker
apps/astron/.docker/**
**/.docker
**/.docker/**

# Status engine runtime state (SQLite database, snapshot, backups). The
# container keeps it in a volume, never in the build context.
apps/status/data
apps/status/.status-data
packages/status/data
.make-product

# Desktop (Electron) and website packaging artifacts: several GB of local build
# output that the server image never needs. Without these the build context is
# ~2.4GB instead of a few MB. The desktop client now lives inside the Astron Collection
# app package, under `apps/astron-collection/electron/`.
apps/astron-collection/electron/release
apps/astron-collection/electron/out
web/apps/docs/out
web/apps/website/.next

# Version control and CI
.git
.gitignore
.github

# Bot runtime state: SQLite files and local caches must never be baked into an
# image — each bot mounts its own named volume at /app/bot/<bot>/data.
bot/*/data
bot/*/.data

# Local environment files (keep the committed *.example files). `**/.env` is
# required here: each bot has its own `.env` next to its Dockerfile, and the bot
# build context is the repository root. Without it those secrets are copied by
# `COPY bot/<bot>/ ./`.
.env
.env.production
.env.local
.env.development.local
.env.test.local
.env.production.local
**/.env
**/.env.production
**/.env.local
**/.env.development.local
**/.env.test.local
**/.env.production.local
!.env.example
!**/.env.example

# Editor / OS noise
.DS_Store
.vscode
.idea
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Docs and non-runtime assets are not needed to build the image.
README.md
