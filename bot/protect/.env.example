[TEMPLATE]
# Protect — moderation and security bot (own Discord application)
ASTRON_PROTECT_DISCORD_TOKEN=
ASTRON_PROTECT_DISCORD_CLIENT_ID=

ASTRON_COMMAND_SCOPE=global
ASTRON_COMMAND_GUILD_ID=

NODE_ENV=production
ASTRON_LOG_LEVEL=info
APP_VERSION=2.0.0
ASTRON_HEALTH_PORT=8080
ASTRON_DATA_DIR=
ASTRON_DATABASE_PATH=

# Moderation events → Logger. Both values are required to enable delivery.
ASTRON_EVENT_URL=
ASTRON_EVENT_SECRET=
