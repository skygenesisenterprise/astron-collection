# Protect — copy to bot/protect/.env, then fill in the credentials.
DISCORD_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_GUILD_ID=

NODE_ENV=production
ASTRON_LOG_LEVEL=info
ASTRON_HEALTH_PORT=3011
ASTRON_DATA_DIR=./data
ASTRON_DATABASE_PATH=./data/protect.sqlite3
ASTRON_DEPLOY_COMMANDS=false
ASTRON_REVIEW_CHANNEL_ID=

# Signed events to Logger. When Logger runs in Docker, publish its port and use
# http://host.docker.internal:3012/ingest/events (same ASTRON_EVENT_SECRET).
ASTRON_EVENT_URL=
ASTRON_EVENT_SECRET=
