# Player — copy to bot/player/.env, then fill in the credentials.
DISCORD_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_GUILD_ID=

NODE_ENV=production
ASTRON_LOG_LEVEL=info
ASTRON_HEALTH_PORT=3015
ASTRON_DATA_DIR=./data
ASTRON_DATABASE_PATH=./data/player.sqlite3
ASTRON_DEPLOY_COMMANDS=false

# ffmpeg and yt-dlp are installed in the image; no host binary is needed.
ASTRON_YTDLP_PATH=/usr/local/bin/yt-dlp

# Optional: forward track.started to Logger.
ASTRON_EVENT_URL=http://host.docker.internal:3012/ingest/events
ASTRON_EVENT_SECRET=
