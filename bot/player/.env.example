# Player — voice music bot
DISCORD_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_GUILD_ID=

ASTRON_HEALTH_PORT=3015
ASTRON_LOG_LEVEL=info
ASTRON_DATABASE_PATH=./data/player.sqlite3

# yt-dlp binary; ffmpeg must also be available on PATH.
ASTRON_YTDLP_PATH=yt-dlp

# Optional: forward track.started events to Logger.
ASTRON_EVENT_URL=
ASTRON_EVENT_SECRET=

ASTRON_DEPLOY_COMMANDS=false
