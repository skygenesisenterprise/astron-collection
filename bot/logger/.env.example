# Astron Collection — Logger bot (bot/logger)
#
# This file is the configuration of THIS bot only. It never contains another
# bot's token or Application ID.
#
#   cp bot/logger/.env.example bot/logger/.env
#
# Precedence: `bot/logger/.env` wins over the repository `.env`.

# ── Discord identity (required) ─────────────────────────────────────────────
# The Logger bot's own Discord application. Do not reuse another bot's token.
ASTRON_LOGGER_DISCORD_TOKEN=
ASTRON_LOGGER_DISCORD_CLIENT_ID=

# ── Command deployment ──────────────────────────────────────────────────────
# global | guild | none
ASTRON_COMMAND_SCOPE=global
ASTRON_COMMAND_GUILD_ID=

# ── Official voice presence ─────────────────────────────────────────────────
ASTRON_VOICE_PRESENCE_ENABLED=true
# Official Astron Collection guild. Central value; override only for staging.
ASTRON_OFFICIAL_GUILD_ID=1369779785273839749
ASTRON_PRESENCE_VOICE_CHANNEL_ID=1564590674194473000

# ── Runtime ─────────────────────────────────────────────────────────────────
NODE_ENV=production
ASTRON_LOG_LEVEL=info
APP_VERSION=1.1.0
GIT_COMMIT_SHA=unknown
BUILD_DATE=unknown

# ── Logger bot behaviour ────────────────────────────────────────────────────
DISCORD_WELCOME_DM_ENABLED=true
DISCORD_ANNOUNCE_DEPLOYMENTS=true
DISCORD_LEVEL_CHANNEL_ID=
DISCORD_ROLE_AGENTS_ID=

# ── Instance cache ──────────────────────────────────────────────────────────
REDIS_ENABLED=true
REDIS_REQUIRED=false
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=astron-logger:v1
