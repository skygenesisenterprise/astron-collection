# Logger — copy to bot/logger/.env, then fill in the credentials.
# Both the prefixed and the generic names are accepted by the bot.
ASTRON_LOGGER_DISCORD_TOKEN=
ASTRON_LOGGER_DISCORD_CLIENT_ID=
DISCORD_TOKEN=
DISCORD_APPLICATION_ID=

NODE_ENV=production
ASTRON_LOG_LEVEL=info
ASTRON_HEALTH_PORT=3012
ASTRON_DATA_DIR=./data
ASTRON_DATABASE_PATH=./data/logger.sqlite3
ASTRON_DEPLOY_COMMANDS=false

# Must match ASTRON_EVENT_SECRET of every emitting bot.
ASTRON_EVENT_SECRET=
ASTRON_INGEST_PATH=/ingest/events
ASTRON_EXPORT_MAX_ROWS=5000
