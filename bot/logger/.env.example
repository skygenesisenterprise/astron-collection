[TEMPLATE]
# Logger — audit and logging bot (own Discord application)
ASTRON_LOGGER_DISCORD_TOKEN=
ASTRON_LOGGER_DISCORD_CLIENT_ID=

ASTRON_COMMAND_SCOPE=global
ASTRON_COMMAND_GUILD_ID=

NODE_ENV=production
ASTRON_LOG_LEVEL=info
APP_VERSION=2.0.0
ASTRON_HEALTH_PORT=8080
ASTRON_DATA_DIR=
ASTRON_DATABASE_PATH=

# Inbound event contracts. Must match the producers' ASTRON_EVENT_SECRET.
ASTRON_EVENT_SECRET=
ASTRON_INGEST_PATH=/ingest/events
ASTRON_EXPORT_MAX_ROWS=5000
