[TEMPLATE]
# Astron — generalist bot
#
# This bot needs its OWN Discord application. Never reuse another bot's token:
# a shared application id makes the catalogues overwrite each other.
ASTRON_ASTRON_DISCORD_TOKEN=
ASTRON_ASTRON_DISCORD_CLIENT_ID=

# Command deployment: global | guild | none
ASTRON_COMMAND_SCOPE=global
ASTRON_COMMAND_GUILD_ID=

# Runtime
NODE_ENV=production
ASTRON_LOG_LEVEL=info
APP_VERSION=2.0.0
ASTRON_HEALTH_PORT=8080
ASTRON_DATA_DIR=
ASTRON_DATABASE_PATH=

# Public links used by /docs, /support and /about
ASTRON_DOCS_URL=https://github.com/skygenesisenterprise/astron-collection/tree/master/bot
ASTRON_SUPPORT_URL=https://github.com/skygenesisenterprise/astron-collection/issues

# Optional event delivery (not required by Astron's own features)
ASTRON_EVENT_URL=
ASTRON_EVENT_SECRET=
