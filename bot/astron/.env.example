# Astron — copy to bot/astron/.env, then fill in the credentials.
# Standalone: docker compose -f bot/astron/docker-compose.yml up -d --build
DISCORD_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_GUILD_ID=

NODE_ENV=production
ASTRON_LOG_LEVEL=info
ASTRON_HEALTH_PORT=3010
ASTRON_DATA_DIR=./data
ASTRON_DATABASE_PATH=./data/astron.sqlite3
ASTRON_DEPLOY_COMMANDS=false

ASTRON_DOCS_URL=https://docs.astron-collection.com
ASTRON_SUPPORT_URL=https://github.com/SkyGenesisEnterprise/astron-collection/issues
