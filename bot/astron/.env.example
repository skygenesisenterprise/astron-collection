# Automations — workflow bot
DISCORD_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_GUILD_ID=

ASTRON_HEALTH_PORT=3014
ASTRON_LOG_LEVEL=info
ASTRON_DATABASE_PATH=./data/automations.sqlite3

# Signed ingest for event triggers (same secret as the emitting bot).
ASTRON_EVENT_SECRET=
ASTRON_INGEST_PATH=/ingest/events

# Optional outbound workflow.executed events to Logger.
ASTRON_EVENT_URL=
ASTRON_OUTBOUND_SECRET=

ASTRON_DEPLOY_COMMANDS=false
