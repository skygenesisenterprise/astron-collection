# Astron Collection — Discord bots, aggregate environment template.
#
# Each bot has its own dedicated template next to it, which is the recommended
# starting point:
#
#   bot/main/.env.example      bot/protect/.env.example
#   bot/logger/.env.example    bot/player/.env.example
#   bot/guild/.env.example
#
# This file keeps the same variables in one place, for a repository `.env`
# consumed by Compose. Credentials are PER BOT: each bot has its own Discord
# application, its own token and its own Application ID, and the variable name
# is derived from the bot directory — ASTRON_<BOT>_DISCORD_TOKEN /
# ASTRON_<BOT>_DISCORD_CLIENT_ID (a hyphen becomes an underscore).
#
#   cp bot/main/.env.example bot/main/.env   # local run: this file wins
#   cp bot/.env.example .env                 # Compose: one file, per-bot variables
#
# The historical shared DISCORD_TOKEN / DISCORD_CLIENT_ID are still read as a
# fallback, but the framework logs a warning when one is used, because two bots
# sharing an Application ID would overwrite each other's command catalogue.

# ── Main (bot/main) ─────────────────────────────────────────────────────────
ASTRON_MAIN_DISCORD_TOKEN=
ASTRON_MAIN_DISCORD_CLIENT_ID=

# ── Protect (bot/protect) ───────────────────────────────────────────────────
ASTRON_PROTECT_DISCORD_TOKEN=
ASTRON_PROTECT_DISCORD_CLIENT_ID=

# ── Logger (bot/logger) ─────────────────────────────────────────────────────
ASTRON_LOGGER_DISCORD_TOKEN=
ASTRON_LOGGER_DISCORD_CLIENT_ID=

# ── Player (bot/player) ─────────────────────────────────────────────────────
ASTRON_PLAYER_DISCORD_TOKEN=
ASTRON_PLAYER_DISCORD_CLIENT_ID=

# ── Guild (bot/guild) ───────────────────────────────────────────────────────
ASTRON_GUILD_DISCORD_TOKEN=
ASTRON_GUILD_DISCORD_CLIENT_ID=

# ── Command deployment (shared behaviour, per-bot scope) ────────────────────
# global  replace this application's global catalogue (default)
# guild   deploy only to ASTRON_COMMAND_GUILD_ID (instant, good for staging)
# none    never touch the Discord catalogue
ASTRON_COMMAND_SCOPE=global
ASTRON_COMMAND_GUILD_ID=
# Deprecated alias, still read when ASTRON_COMMAND_SCOPE is unset.
DISCORD_COMMAND_SCOPE=

# ── Official voice presence (framework) ─────────────────────────────────────
# The bots join this voice channel silently on the official guild, after the
# client is ready. It is a presence marker, never an audio channel.
ASTRON_VOICE_PRESENCE_ENABLED=true
# Official Astron Collection guild. Central value; override only for staging.
ASTRON_OFFICIAL_GUILD_ID=1369779785273839749
# Central default is the official Astron Collection channel; override only for
# a staging guild.
ASTRON_PRESENCE_VOICE_CHANNEL_ID=1564590674194473000

# ── Runtime ─────────────────────────────────────────────────────────────────
NODE_ENV=production
ASTRON_LOG_LEVEL=info
APP_VERSION=1.1.0
GIT_COMMIT_SHA=unknown
BUILD_DATE=unknown

# ── Bot behaviour (optional) ────────────────────────────────────────────────
DISCORD_WELCOME_DM_ENABLED=true
DISCORD_ANNOUNCE_DEPLOYMENTS=true
DISCORD_LEVEL_CHANNEL_ID=
DISCORD_ROLE_AGENTS_ID=

# ── Per-instance cache (optional) ───────────────────────────────────────────
REDIS_ENABLED=true
REDIS_REQUIRED=false
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=
