# Astron Collection Discord bots — shared template.
#
# Each bot is a separate Discord application with its own token and application
# id. Copy the per-bot template instead of sharing this file:
#
#   cp bot/astron/.env.example      bot/astron/.env
#   cp bot/automations/.env.example bot/automations/.env
#   cp bot/guild/.env.example       bot/guild/.env
#   cp bot/logger/.env.example      bot/logger/.env
#   cp bot/player/.env.example      bot/player/.env
#   cp bot/protect/.env.example     bot/protect/.env
#
# Never give two bots the same DISCORD_APPLICATION_ID: a global command
# deployment replaces the application's whole catalogue.

DISCORD_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_GUILD_ID=

ASTRON_LOG_LEVEL=info
ASTRON_HEALTH_PORT=3010
ASTRON_DATABASE_PATH=./data/astron.sqlite3

# Cross-bot contracts. The emitter must use the same secret as Logger's ingest.
# Bots run as independent Compose projects; use the published port through
# host.docker.internal (already mapped in every bot/docker-compose.yml).
# Leave the URL empty to keep events in the emitter's outbox.
ASTRON_EVENT_URL=http://host.docker.internal:3012/ingest/events
ASTRON_EVENT_SECRET=

# Set to true once to deploy a bot's slash commands at start, then remove it.
ASTRON_DEPLOY_COMMANDS=false
