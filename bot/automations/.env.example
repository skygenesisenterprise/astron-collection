# Automations — copy to bot/automations/.env, then fill in the credentials.
DISCORD_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_GUILD_ID=

NODE_ENV=production
ASTRON_LOG_LEVEL=info
ASTRON_HEALTH_PORT=3014
ASTRON_DATA_DIR=./data
ASTRON_DATABASE_PATH=./data/automations.sqlite3
ASTRON_DEPLOY_COMMANDS=false

# Signed ingest for event triggers (same secret as the emitting bots).
ASTRON_INGEST_PATH=/ingest/events
ASTRON_EVENT_SECRET=
ASTRON_OUTBOUND_SECRET=

# Optional: forward workflow.executed to Logger.
ASTRON_EVENT_URL=http://host.docker.internal:3012/ingest/events
