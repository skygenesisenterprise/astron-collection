# Guild — community bot
DISCORD_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_GUILD_ID=

ASTRON_HEALTH_PORT=3013
ASTRON_LOG_LEVEL=info
ASTRON_DATABASE_PATH=./data/guild.sqlite3

# Optional: forward community events (member.joined, member.left, level.up,
# suggestion.created) to Logger. The secret must match Logger's ASTRON_EVENT_SECRET.
ASTRON_EVENT_URL=
ASTRON_EVENT_SECRET=

# Set to true once to deploy slash commands at container start (then remove it).
ASTRON_DEPLOY_COMMANDS=false
