# ── Discord Bot ────────────────────────────────────────────
NODE_ENV=production
LOG_LEVEL=info
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_WELCOME_DM_ENABLED=true
DISCORD_COMMAND_SCOPE=global
DISCORD_ANNOUNCE_DEPLOYMENTS=true

# ── Redis (Optional) ───────────────────────────────────────
REDIS_PASSWORD=redis-default-password
REDIS_ENABLED=true
REDIS_REQUIRED=false
