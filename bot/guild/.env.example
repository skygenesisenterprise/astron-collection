# Guild — copy to bot/guild/.env, then fill in the credentials.
DISCORD_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_GUILD_ID=

NODE_ENV=production
ASTRON_LOG_LEVEL=info
ASTRON_HEALTH_PORT=3013
ASTRON_DATA_DIR=./data
ASTRON_DATABASE_PATH=./data/guild.sqlite3
ASTRON_DEPLOY_COMMANDS=false

# Optional: forward events to Logger's published port, same shared secret.
ASTRON_EVENT_URL=http://host.docker.internal:3012/ingest/events
ASTRON_EVENT_SECRET=
