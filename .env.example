[TEMPLATE]
# Astron Collection — environment template for the root Docker Compose stack.
#
#   cp .env.example .env
#
# `.env` is read by Compose (interpolation) and by the services. It must never be
# committed: it contains the database, Redis and session secrets.
#
# Generate every secret with:
#
#   openssl rand -hex 32
#
# The stack refuses to start when POSTGRES_PASSWORD, REDIS_PASSWORD or
# BETTER_AUTH_SECRET is missing, and the API refuses to boot with a known or
# too-short BETTER_AUTH_SECRET.

# ── Profiles ────────────────────────────────────────────────────────────────
# `prod` starts postgres, redis, migrate, api and client.
# `dev`  starts postgres, redis, api-dev and client-dev (hot reload).
# Switch modes with `COMPOSE_PROFILES=dev docker compose up --build client-dev api-dev`.
COMPOSE_PROFILES=prod

# ── Ports published on the host ─────────────────────────────────────────────
# Only the dashboard and the API are published; PostgreSQL and Redis are internal.
ASTRON_COLLECTION_PORT=3000
ASTRON_COLLECTION_API_PORT=4000

# ── PostgreSQL (GROUP 1 — database) ─────────────────────────────────────────
POSTGRES_USER=astron-collection
POSTGRES_DB=astron-collection
# REQUIRED. No default on purpose: `docker compose up` fails without it.
POSTGRES_PASSWORD=

# ── Redis (GROUP 2 — cache / queue) ─────────────────────────────────────────
# REQUIRED. Used for the cache, BullMQ queues and coordination.
REDIS_PASSWORD=

# ── Client (GROUP 3 — frontend) ─────────────────────────────────────────────
# Public origin of the API as seen by the browser. Used for the WebSocket
# connection; HTTP calls go through the client origin and are proxied to the API.
# Baked into the browser bundle at build time, so change it before building.
NEXT_PUBLIC_API_URL=http://localhost:4000

# ── API (GROUP 4 — backend) ─────────────────────────────────────────────────
# REQUIRED. Session signing secret. Use a random 32-byte hex value:
#   openssl rand -hex 32
BETTER_AUTH_SECRET=
# Public origin of the dashboard (where users sign in).
BETTER_AUTH_URL=http://localhost:3000
# Origins allowed to send authenticated requests, comma separated.
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Optional integrations ───────────────────────────────────────────────────
# Empty values disable the provider. The redirect URLs point at the client
# origin: the browser authenticates there, and the API answers through the proxy.
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
OAUTH_DISCORD_CLIENT_ID=
OAUTH_DISCORD_CLIENT_SECRET=

# ── Development only ────────────────────────────────────────────────────────
# Inotify works through bind mounts on Linux. Set to true on Docker Desktop.
DEV_POLLING=false
TZ=UTC
