# Astron Collection website — optional configuration.
# Copy to `.env.local` for `next dev`; for a static export the values are
# inlined at build time.

# Contact form (see app/api/contact/route.ts).
RESEND_API_KEY=

# ---------------------------------------------------------------------------
# Bot invitations
#
# Discord does not publish invite links: they are OAuth2 authorisation URLs
# built from the application's client ID. Set one of the two variables per
# application — the full URL wins over the client ID. Without either, the site
# links to the community Discord instead of a broken invite.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_DISCORD_CLIENT_ID_ASTRON=
NEXT_PUBLIC_DISCORD_CLIENT_ID_GUILD=
NEXT_PUBLIC_DISCORD_CLIENT_ID_LOGGER=
NEXT_PUBLIC_DISCORD_CLIENT_ID_PROTECT=
NEXT_PUBLIC_DISCORD_CLIENT_ID_PLAYER=