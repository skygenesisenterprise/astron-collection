# Base URL used for metadata and canonical links (defaults to https://docs.astron-collection.com).
# NEXT_PUBLIC_APP_URL=https://docs.astron-collection.com

# --- Astron Collection Traffic Manager instrumentation --------------------------------
# Both values come from Astron Collection: Dashboard > Website > Traffic > Platforms &
# sources > Install, on the property that represents this site. Without them the
# instrumentation is not loaded at all and no audience data is collected.
# NEXT_PUBLIC_ASTRON_COLLECTION_TRAFFIC_ENDPOINT=https://<astron-collection-host>
# NEXT_PUBLIC_ASTRON_COLLECTION_TRAFFIC_KEY=pk_...
